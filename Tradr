--// TOGGLE FUNCTION
local function updateToggle()
    if enabled then
        tween(knob, 0.2, {
            Position = UDim2.new(1, -32, 0, 4)
        })
        tween(toggle, 0.2, {
            BackgroundColor3 = Color3.fromRGB(62, 105, 72)
        })

        description.Text = "Freeze Trade Active ✦"
        banner.Text = "★  Freeze Trade Active  ★"
    else
        tween(knob, 0.2, {
            Position = UDim2.fromOffset(4, 4)
        })
        tween(toggle, 0.2, {
            BackgroundColor3 = GRAY
        })

        description.Text = "Freeze Trade Inactive ✦"
        banner.Text = "★  Freeze Trade Inactive  ★"
    end
end

toggle.Activated:Connect(function()
    enabled = not enabled
    updateToggle()
end)

--// DRAG FUNCTION: MOUSE + TOUCH
local dragging = false
local dragStart
local startPosition
local dragInput

panel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        -- Don't start dragging on the toggle
        local p = input.Position
        local absPos = toggle.AbsolutePosition
        local absSize = toggle.AbsoluteSize

        local onToggle =
            p.X >= absPos.X and p.X <= absPos.X + absSize.X
            and p.Y >= absPos.Y and p.Y <= absPos.Y + absSize.Y

        if onToggle then
            return
        end

        dragging = true
        dragStart = input.Position
        startPosition = panel.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

panel.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input == dragInput
        or input.UserInputType == Enum.UserInputType.MouseMovement
    ) then
        local delta = input.Position - dragStart

        panel.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

