local InventoryModule  = require(RS_Modules:WaitForChild("InventoryModule"))
local ItemPopupService = require(RS_ClientServices:WaitForChild("ItemPopupService"))

local ItemLookup = {}
local ItemNames  = {}
local ITEM_TYPES = { "Weapons", "Effects", "Perks", "Emotes", "Radios", "Pets" }

for _, cat in ipairs(ITEM_TYPES) do
    local bucket = SyncDB[cat]
    if bucket then
        for id, data in pairs(bucket) do
            local name  = data.ItemName or data.Name or id
            local entry = {
                id      = id,
                type    = cat,
                display = name .. " [" .. cat .. "]",
            }
            ItemLookup[string.lower(id)]   = entry
            ItemLookup[string.lower(name)] = entry
            table.insert(ItemNames, id)
        end
    end
end
table.sort(ItemNames)

local createdCodes = {}

local function injectAndPopup(itemID, itemType, amount)
    local owned = ProfileData[itemType] and ProfileData[itemType].Owned
    if owned then
        local isKeyed = (itemType == "Weapons" or itemType == "Pets")
        if isKeyed then
            owned[itemID] = (tonumber(owned[itemID]) or 0) + amount
        else
            local found = false
            for _, v in ipairs(owned) do
                if v == itemID then found = true; break end
            end
            if not found then table.insert(owned, itemID) end
        end
    end

    pcall(function()
        if InventoryModule and InventoryModule.MyInventory then
            local myInv = InventoryModule.MyInventory
            if myInv.Data and myInv.Sort then
                if not myInv.Data[itemType] then
                    myInv.Data[itemType] = {}
                    myInv.Sort[itemType] = {}
                end
                local tabKey = "Current"
                if not myInv.Data[itemType][tabKey] then
                    myInv.Data[itemType][tabKey] = {}
                    myInv.Sort[itemType][tabKey] = {}
                end
                if not myInv.Data[itemType][tabKey][itemID] then
                    local rawData = SyncDB[itemType] and SyncDB[itemType][itemID]
                    local entry   = {}
                    if rawData then
                        for k, v in pairs(rawData) do entry[k] = v end
                    end
                    entry.Name        = rawData and (rawData.ItemName or rawData.Name) or itemID
                    entry.Amount      = amount
                    entry.DataID      = itemID
                    entry.DataType    = itemType
                    entry.Rarity      = entry.Rarity or "Common"
                    entry.Frame       = nil
                    entry.LayoutOrder = 0
                    myInv.Data[itemType][tabKey][itemID] = entry
                    table.insert(myInv.Sort[itemType][tabKey], itemID)
                    local InvMain = InventoryModule.GUI
                        and InventoryModule.GUI.MyInventory
                        and InventoryModule.GUI.MyInventory.Main
                    if InvMain then
                        InventoryModule.SortTab(myInv, itemType, tabKey)
                        InventoryModule.GenerateNewInventoryFrames(myInv, InvMain)
                        InventoryModule.ConnectEquipButtons()
                    end
                end
            end
        end
    end)

    pcall(function()
        ItemPopupService.ItemReceived:Fire(itemID, itemType, amount)
    end)
end

local function createCode(codeStr, itemID, itemType, amount)
    codeStr = string.upper(string.gsub(codeStr, "%s+", ""))
    if codeStr == "" or #codeStr < 3 then
        return false, "Code too short (min 3 chars)"
    end
    createdCodes[codeStr] = { itemID = itemID, itemType = itemType, amount = amount }
    if not SyncDB.Codes then SyncDB.Codes = {} end
    SyncDB.Codes[codeStr] = { Code = codeStr, Active = true, Type = "Normal", Uses = 999 }
    return true, "Code created!"
end

local function getCodeFrame()
    local ok, result = pcall(function()
        local pg  = lp:WaitForChild("PlayerGui", 5)
        local mg  = pg:WaitForChild("MainGUI", 5)
        local lb  = mg:WaitForChild("Lobby", 5)
        local sc  = lb:WaitForChild("Screens", 5)
        local inv = sc:WaitForChild("Inventory", 5)
        local nav = inv:WaitForChild("Nav", 5)
        local mn  = nav:WaitForChild("Main", 5)
        return mn:WaitForChild("Codes", 5)
    end)
    return ok and result or nil
end

local CodeFrame = getCodeFrame()
if CodeFrame then
    local CodeBox   = CodeFrame:FindFirstChild("CodeBox")
    local RedeemBtn = CodeFrame:FindFirstChild("Redeem")
    if CodeBox and RedeemBtn then
        local function rewire(inst)
            local clone = inst:Clone()
            clone.Parent = inst.Parent
            inst:Destroy()
            return clone
        end
        CodeBox   = rewire(CodeBox)
        RedeemBtn = rewire(RedeemBtn)
        CodeBox   = CodeFrame:WaitForChild("CodeBox")
        RedeemBtn = CodeFrame:WaitForChild("Redeem")

        CodeBox:GetPropertyChangedSignal("Text"):Connect(function()
            local code = string.upper(string.gsub(CodeBox.Text, "%s+", ""))
            RedeemBtn.Style = createdCodes[code]
                and Enum.ButtonStyle.RobloxRoundDefaultButton
                or  Enum.ButtonStyle.RobloxRoundButton
        end)

        RedeemBtn.MouseButton1Click:Connect(function()
            local code = string.upper(string.gsub(CodeBox.Text, "%s+", ""))
            if createdCodes[code] then
                local d = createdCodes[code]
                injectAndPopup(d.itemID, d.itemType, d.amount)
                CodeBox.Text       = "✅ Redeemed! (+" .. d.amount .. " " .. d.itemID .. ")"
                RedeemBtn.Style    = Enum.ButtonStyle.RobloxRoundButton
                createdCodes[code] = nil
                if SyncDB.Codes then SyncDB.Codes[code] = nil end
                return
            end
            local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
            local extras  = remotes:WaitForChild("Extras", 5)
            local ok, responseText, rewardList = pcall(function()
                return extras.RedeemCode:InvokeServer(code, "Normal")
            end)
            if ok and rewardList and type(rewardList) == "table" then
                CodeBox.Text = tostring(responseText or "✅ Redeemed!")
                for _, reward in ipairs(rewardList) do
                    injectAndPopup(
                        reward.ID   or reward[1],
                        reward.Type or reward[2] or "Weapons",
                        reward.Amount or 1
                    )
                end
            else
                CodeBox.Text = "❌ Invalid code"
            end
        end)
    end
end

