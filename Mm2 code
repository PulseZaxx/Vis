    Desc        = "Min 3 chars — auto-uppercased",
    Placeholder = "e.g. VEGA2025",
    Flag        = "CodeName",
    Callback    = function(val) codeNameVal = val end,
})

ForgeSection:Input({
    Title       = "Reward Item",
    Desc        = "Type item ID or display name (e.g. Sword_001 or Excalibur)",
    Placeholder = "Item ID or Name",
    Flag        = "RewardItem",
    Callback    = function(val) itemInputVal = val end,
})

ForgeSection:Input({
    Title       = "Amount",
    Desc        = "Number of items to grant (1–999)",
    Placeholder = "1",
    Flag        = "ItemAmount",
    Callback    = function(val) amountVal = val end,
})

ForgeSection:Paragraph({
    Title = "How to use",
    Desc  = "Fill Code Name + Item + Amount, then hit Create.\n"
          .. "The code is auto-copied to clipboard after creation.\n"
          .. "Redeem it in the in-game Codes screen.",
})

ForgeSection:Button({
    Title     = "⚡ Create Code",
    Desc      = "Registers the code and patches SyncDB client-side",
    Icon      = "zap",
    IconColor = Color3.fromRGB(0, 180, 255),
    Callback  = function()
        local codeStr  = string.upper(string.gsub(codeNameVal, "%s+", ""))
        local rawItem  = string.gsub(itemInputVal, "%s+", "")
        local amount   = math.clamp(math.floor(tonumber(amountVal) or 1), 1, 999)

        if codeStr == "" or #codeStr < 3 then
            notify("Vega Scripts", "✗ Code name too short (min 3 chars).", 3)
            return
        end

        local itemData = nil
        local itemType = nil

        for _, cat in ipairs(ITEM_TYPES) do
            local bucket = SyncDB[cat]
            if bucket then
                if bucket[rawItem] then
                    itemData = bucket[rawItem]
                    itemType = cat
                    break
                end
                for id, data in pairs(bucket) do
                    local name = data.ItemName or data.Name or id
                    if string.lower(id) == string.lower(rawItem) or string.lower(name) == string.lower(rawItem) then
                        rawItem  = id
                        itemData = data
                        itemType = cat
                        break
                    end
                end
            end
            if itemData then break end
        end

        if not itemData then
            notify("Vega Scripts",
                "✗ Item \"" .. rawItem .. "\" not found in SyncDB.\n"
             .. "Try typing the exact ID or display name.",
                4)
            return
        end

        local ok, msg = createCode(codeStr, rawItem, itemType, amount)
        if ok then
            pcall(function() setclipboard(codeStr) end)
            notify(
                "✅ Code Created",
                codeStr .. " → " .. amount .. "x " .. rawItem
                    .. " [" .. itemType .. "]\nCopied to clipboard.",
                5
            )
        else
            notify("Vega Scripts", "✗ " .. msg, 3)
        end
    end,
})

ForgeSection:Button({
    Title     = "📋 Copy Code",
    Desc      = "Copies the Code Name field to clipboard",
    Icon      = "clipboard",
    IconColor = Color3.fromRGB(120, 200, 120),
